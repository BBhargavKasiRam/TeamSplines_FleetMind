# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.msg text eol=lf
*.srv text eol=lf
*.action text eol=lf
*.world text eol=lf
*.sdf text eol=lf
*.urdf text eol=lf
*.xacro text eol=lf
*.rviz text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
package.xml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dae binary
*.obj binary
*.mtl binary
*.psd binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pdf binary
*.tar binary
*.gz binary
*.zip binary
