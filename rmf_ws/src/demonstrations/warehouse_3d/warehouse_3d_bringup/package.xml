<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_3d_bringup</name>
  <version>1.0.0</version>
  <description>Complete standalone bringup system for 3D warehouse robot simulation</description>
  <maintainer email="warehouse_sim@simulation.local">Autonomous Warehouse Simulation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>rviz2</depend>
  <depend>warehouse_3d_interfaces</depend>
  <depend>warehouse_3d_world</depend>
  <depend>warehouse_3d_description</depend>
  <depend>warehouse_3d_robot</depend>
  <depend>warehouse_logic_adapter</depend>
  <depend>warehouse_task_generator</depend>
  <depend>warehouse_3d_visualization</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
