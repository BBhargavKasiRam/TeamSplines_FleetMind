    <plugin name='gz::sim::systems::DiffDrive' filename='gz-sim-diff-drive-system'>
      <left_joint>robot_alpha/left_wheel_joint</left_joint>
      <right_joint>robot_alpha/right_wheel_joint</right_joint>
      <wheel_separation>0.46</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>3.0</max_linear_velocity>
      <min_linear_velocity>-3.0</min_linear_velocity>
      <max_angular_velocity>2.5</max_angular_velocity>
      <min_angular_velocity>-2.5</min_angular_velocity>
      <topic>robot_alpha/cmd_vel</topic>
      <odom_topic>robot_alpha/odom</odom_topic>
      <tf_topic>robot_alpha/tf</tf_topic>
      <frame_id>robot_alpha/odom</frame_id>
      <child_frame_id>robot_alpha/base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>
