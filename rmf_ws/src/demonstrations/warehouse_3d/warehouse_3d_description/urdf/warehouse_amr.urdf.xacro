<?xml version="1.0"?>
<robot name="warehouse_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments -->
  <xacro:arg name="robot_name" default="Alpha" />
  <xacro:arg name="robot_color" default="Blue" />
  <xacro:arg name="robot_namespace" default="robot_alpha" />
  <xacro:arg name="robot_id" default="1" />

  <xacro:property name="name" value="$(arg robot_name)" />
  <xacro:property name="color" value="$(arg robot_color)" />
  <xacro:property name="ns" value="$(arg robot_namespace)" />
  <xacro:property name="id" value="$(arg robot_id)" />

  <!-- Dimensions -->
  <xacro:property name="chassis_length" value="0.72" />
  <xacro:property name="chassis_width" value="0.52" />
  <xacro:property name="chassis_height" value="0.26" />
  <xacro:property name="wheel_radius" value="0.10" />
  <xacro:property name="wheel_width" value="0.05" />
  <xacro:property name="wheel_separation" value="0.46" />
  <xacro:property name="caster_radius" value="0.04" />

  <!-- Colors Selection -->
  <material name="chassis_dark">
    <color rgba="0.2 0.22 0.25 1.0" />
  </material>

  <material name="robot_accent">
    <xacro:if value="${color == 'Blue'}">
      <color rgba="0.12 0.45 0.95 1.0" />
    </xacro:if>
    <xacro:if value="${color == 'Red'}">
      <color rgba="0.95 0.15 0.15 1.0" />
    </xacro:if>
    <xacro:if value="${color == 'Green'}">
      <color rgba="0.15 0.85 0.25 1.0" />
    </xacro:if>
    <xacro:if value="${color == 'Yellow'}">
      <color rgba="0.95 0.85 0.10 1.0" />
    </xacro:if>
    <xacro:if value="${color == 'Purple'}">
      <color rgba="0.75 0.18 0.92 1.0" />
    </xacro:if>
  </material>

  <xacro:if value="${color == 'Blue'}">
    <xacro:property name="gz_diffuse" value="0.12 0.45 0.95 1.0" />
    <xacro:property name="gz_ambient" value="0.10 0.35 0.85 1.0" />
    <xacro:property name="gz_emissive" value="0.08 0.20 0.45 1.0" />
  </xacro:if>
  <xacro:if value="${color == 'Red'}">
    <xacro:property name="gz_diffuse" value="0.95 0.15 0.15 1.0" />
    <xacro:property name="gz_ambient" value="0.85 0.10 0.10 1.0" />
    <xacro:property name="gz_emissive" value="0.45 0.08 0.08 1.0" />
  </xacro:if>
  <xacro:if value="${color == 'Green'}">
    <xacro:property name="gz_diffuse" value="0.15 0.85 0.25 1.0" />
    <xacro:property name="gz_ambient" value="0.10 0.75 0.20 1.0" />
    <xacro:property name="gz_emissive" value="0.08 0.40 0.12 1.0" />
  </xacro:if>
  <xacro:if value="${color == 'Yellow'}">
    <xacro:property name="gz_diffuse" value="0.95 0.85 0.10 1.0" />
    <xacro:property name="gz_ambient" value="0.85 0.75 0.08 1.0" />
    <xacro:property name="gz_emissive" value="0.40 0.35 0.04 1.0" />
  </xacro:if>
  <xacro:if value="${color == 'Purple'}">
    <xacro:property name="gz_diffuse" value="0.75 0.18 0.92 1.0" />
    <xacro:property name="gz_ambient" value="0.65 0.12 0.80 1.0" />
    <xacro:property name="gz_emissive" value="0.35 0.08 0.40 1.0" />
  </xacro:if>

  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0" />
  </material>
  <material name="sensor_black">
    <color rgba="0.15 0.15 0.15 1.0" />
  </material>
  <material name="badge_white">
    <color rgba="0.95 0.95 0.95 1.0" />
  </material>

  <!-- Base Footprint -->
  <link name="${ns}/base_footprint" />

  <joint name="${ns}/base_joint" type="fixed">
    <parent link="${ns}/base_footprint" />
    <child link="${ns}/base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <!-- Base Link / Lower Chassis -->
  <link name="${ns}/base_link">
    <inertial>
      <mass value="25.0" />
      <origin xyz="0 0 0.08" rpy="0 0 0" />
      <inertia ixx="0.45" ixy="0.0" ixz="0.0"
               iyy="0.65" iyz="0.0" izz="0.85" />
    </inertial>

    <!-- Main Rugged Body -->
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="chassis_dark" />
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>

  </link>

  <!-- Visual Colored Shell & High-Visibility Accent as dedicated link for Gazebo and RViz -->
  <link name="${ns}/shell_link">
    <inertial>
      <mass value="0.5" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005" />
    </inertial>
    <!-- Visual Colored Shell Top -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length - 0.02} ${chassis_width - 0.02} 0.04" />
      </geometry>
      <material name="robot_accent" />
    </visual>
    <!-- Front Colored Bumper Accent -->
    <visual>
      <origin xyz="${chassis_length/2.0} 0 -0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.06 ${chassis_width - 0.04} 0.14" />
      </geometry>
      <material name="robot_accent" />
    </visual>
    <!-- Glowing Top Beacon -->
    <visual>
      <origin xyz="-0.15 0 0.07" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.07" length="0.10" />
      </geometry>
      <material name="robot_accent" />
    </visual>
    <!-- High-Visibility Vertical Indicator Mast at Back of Robot -->
    <visual>
      <origin xyz="-0.28 0 0.32" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.012" length="0.60" />
      </geometry>
      <material name="chassis_dark" />
    </visual>
    <!-- Top Identity Orb on Mast -->
    <visual>
      <origin xyz="-0.28 0 0.62" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.055" />
      </geometry>
      <material name="robot_accent" />
    </visual>
    <!-- Identification Nameplate Badge on Deck -->
    <visual>
      <origin xyz="0.05 0 0.022" rpy="0 0 0" />
      <geometry>
        <box size="0.25 0.35 0.01" />
      </geometry>
      <material name="badge_white" />
    </visual>
  </link>

  <joint name="${ns}/shell_joint" type="fixed">
    <parent link="${ns}/base_link" />
    <child link="${ns}/shell_link" />
    <origin xyz="0 0 ${chassis_height/2.0 + 0.08 + 0.02}" rpy="0 0 0" />
  </joint>

  <!-- Left Drive Wheel -->
  <link name="${ns}/left_wheel_link">
    <inertial>
      <mass value="2.5" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.007" ixy="0" ixz="0" iyy="0.007" iyz="0" izz="0.0125" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="wheel_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
  </link>

  <joint name="${ns}/left_wheel_joint" type="continuous">
    <parent link="${ns}/base_link" />
    <child link="${ns}/left_wheel_link" />
    <origin xyz="0 ${wheel_separation/2.0} 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Right Drive Wheel -->
  <link name="${ns}/right_wheel_link">
    <inertial>
      <mass value="2.5" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.007" ixy="0" ixz="0" iyy="0.007" iyz="0" izz="0.0125" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="wheel_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
  </link>

  <joint name="${ns}/right_wheel_joint" type="continuous">
    <parent link="${ns}/base_link" />
    <child link="${ns}/right_wheel_link" />
    <origin xyz="0 -${wheel_separation/2.0} 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Front Caster Wheel -->
  <link name="${ns}/front_caster_link">
    <inertial>
      <mass value="0.8" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
      <material name="wheel_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.01</mu>
            <mu2>0.01</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <joint name="${ns}/front_caster_joint" type="fixed">
    <parent link="${ns}/base_link" />
    <child link="${ns}/front_caster_link" />
    <origin xyz="${chassis_length/2.0 - 0.08} 0 -${wheel_radius - caster_radius}" rpy="0 0 0" />
  </joint>

  <!-- Rear Caster Wheel -->
  <link name="${ns}/rear_caster_link">
    <inertial>
      <mass value="0.8" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
      <material name="wheel_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.01</mu>
            <mu2>0.01</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <joint name="${ns}/rear_caster_joint" type="fixed">
    <parent link="${ns}/base_link" />
    <child link="${ns}/rear_caster_link" />
    <origin xyz="-${chassis_length/2.0 - 0.08} 0 -${wheel_radius - caster_radius}" rpy="0 0 0" />
  </joint>

  <!-- LiDAR Sensor -->
  <link name="${ns}/lidar_link">
    <inertial>
      <mass value="0.3" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.06" />
      </geometry>
      <material name="sensor_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.06" />
      </geometry>
    </collision>
  </link>

  <joint name="${ns}/lidar_joint" type="fixed">
    <parent link="${ns}/base_link" />
    <child link="${ns}/lidar_link" />
    <origin xyz="${chassis_length/2.0 - 0.12} 0 ${chassis_height/2.0 + 0.11}" rpy="0 0 0" />
  </joint>

  <!-- Forward Camera Sensor -->
  <link name="${ns}/camera_link">
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.08 0.03" />
      </geometry>
      <material name="sensor_black" />
    </visual>
  </link>

  <joint name="${ns}/camera_joint" type="fixed">
    <parent link="${ns}/base_link" />
    <child link="${ns}/camera_link" />
    <origin xyz="${chassis_length/2.0 + 0.01} 0 0.10" rpy="0 0 0" />
  </joint>

  <!-- IMU Sensor -->
  <link name="${ns}/imu_link">
    <inertial>
      <mass value="0.05" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
    </inertial>
  </link>

  <joint name="${ns}/imu_joint" type="fixed">
    <parent link="${ns}/base_link" />
    <child link="${ns}/imu_link" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
  </joint>

  <!-- Gazebo Sensors and Diff Drive Plugins -->
  <gazebo reference="${ns}/base_link">
    <visual>
      <material>
        <diffuse>0.2 0.22 0.25 1.0</diffuse>
        <ambient>0.15 0.18 0.20 1.0</ambient>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="${ns}/shell_link">
    <visual>
      <material>
        <diffuse>${gz_diffuse}</diffuse>
        <ambient>${gz_ambient}</ambient>
        <specular>0.6 0.6 0.6 1.0</specular>
        <emissive>${gz_emissive}</emissive>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="${ns}/lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose relative_to="${ns}/lidar_link">0 0 0 0 0 0</pose>
      <topic>${ns}/scan</topic>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>16.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="${ns}/camera_link">
    <sensor name="camera" type="camera">
      <pose relative_to="${ns}/camera_link">0 0 0 0 0 0</pose>
      <topic>${ns}/camera/image_raw</topic>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="${ns}/imu_link">
    <sensor name="imu" type="imu">
      <pose relative_to="${ns}/imu_link">0 0 0 0 0 0</pose>
      <topic>${ns}/imu</topic>
      <update_rate>50</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- Gazebo Differential Drive Plugin -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>${ns}/left_wheel_joint</left_joint>
      <right_joint>${ns}/right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>3.0</max_linear_velocity>
      <min_linear_velocity>-3.0</min_linear_velocity>
      <max_angular_velocity>2.5</max_angular_velocity>
      <min_angular_velocity>-2.5</min_angular_velocity>
      <topic>${ns}/cmd_vel</topic>
      <odom_topic>${ns}/odom</odom_topic>
      <tf_topic>${ns}/tf</tf_topic>
      <frame_id>${ns}/odom</frame_id>
      <child_frame_id>${ns}/base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>${ns}/joint_states</topic>
      <joint_name>${ns}/left_wheel_joint</joint_name>
      <joint_name>${ns}/right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
