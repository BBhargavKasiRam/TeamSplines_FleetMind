<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_3d_robot</name>
  <version>1.0.0</version>
  <description>Robot spawning, state broadcasting, and TF management for warehouse AMR fleet</description>
  <maintainer email="warehouse_sim@simulation.local">Autonomous Warehouse Simulation Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>warehouse_3d_interfaces</depend>
  <depend>warehouse_3d_description</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
