Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.6
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Offset:
        X: 5
        Y: 10
        Z: 0
      Plane: XY
      Plane Cell Count: 25
      Reference Frame: map
      Value: true
    - Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 16; 185; 129
      Enabled: true
      Keep: 100
      Name: Edge_AMR_1_Odom
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Value: /edge_amr_1/odom
    - Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 6; 182; 212
      Enabled: true
      Keep: 100
      Name: Edge_AMR_2_Odom
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Value: /edge_amr_2/odom
    - Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 244; 63; 94
      Enabled: true
      Keep: 100
      Name: Trad_AMR_1_Odom
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Value: /trad_amr_1/odom
    - Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 245; 158; 11
      Enabled: true
      Keep: 100
      Name: Trad_AMR_2_Odom
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Value: /trad_amr_2/odom
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 16; 185; 129
      Enabled: true
      Name: Edge_1_Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Value: /edge_amr_1/plan
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 244; 63; 94
      Enabled: true
      Name: Trad_1_Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Value: /trad_amr_1/plan
  Enabled: true
  Global Options:
    Background Color: 15; 23; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Detectors: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 28.0
      Focal Point:
        X: 5.0
        Y: 10.0
        Z: 0.0
      Name: Current View
      Pitch: 1.25
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 4.71
