      <visual name='right_wheel_visual'>
        <pose frame=''>0.071 0 0 -3.14159 0 -3.14159</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://TinyRobot/meshes/front_wheel.dae</uri>
          </mesh>
        </geometry>
