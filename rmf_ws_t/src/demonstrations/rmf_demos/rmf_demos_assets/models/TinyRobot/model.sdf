      <!-- ============================================================== -->
      <!-- CIRCULAR LOW-PROFILE PUCK AMR WITH MOTORIZED TURNTABLE DECK    -->
      <!-- Modern Titanium Chassis, Dark Skirts & Glowing Cyan LED Band   -->
      <!-- ============================================================== -->

      <!-- 1. Lower Protective Bumper Skirt (Matte Obsidian Black) -->
      <visual name='puck_lower_skirt_visual'>
        <pose frame=''>-0.10 0 0.045 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.335</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.09 0.10 1.0</ambient>
          <diffuse>0.12 0.13 0.15 1.0</diffuse>
          <specular>0.2 0.2 0.25 1.0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- 2. Glowing Cyan/Blue LED Status Band (360-degree perimeter ring) -->
      <visual name='puck_led_status_band_visual'>
        <pose frame=''>-0.10 0 0.078 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.338</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.75 1.0 1.0</ambient>
          <diffuse>0.1 0.85 1.0 1.0</diffuse>
          <specular>0.9 0.95 1.0 1.0</specular>
          <emissive>0.0 0.82 1.0 1.0</emissive>
        </material>
      </visual>

      <!-- 3. Main Circular Puck Body (Brushed Titanium Metallic Silver) -->
      <visual name='puck_main_chassis_visual'>
        <pose frame=''>-0.10 0 0.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.330</radius>
            <length>0.13</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.35 0.38 0.42 1.0</ambient>
          <diffuse>0.62 0.65 0.70 1.0</diffuse>
          <specular>0.85 0.88 0.92 1.0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- 4. Chamfered Top Bevel Collar (Sleek Dark Slate Transition) -->
      <visual name='puck_bevel_collar_visual'>
        <pose frame=''>-0.10 0 0.22 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.310</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.20 0.22 0.26 1.0</ambient>
          <diffuse>0.30 0.33 0.38 1.0</diffuse>
          <specular>0.4 0.45 0.5 1.0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- 5. Top Motorized Turntable Deck Plate (Contrasting Dark Graphite Disc) -->
      <visual name='puck_turntable_deck_visual'>
        <pose frame=''>-0.10 0 0.238 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.250</radius>
            <length>0.022</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.11 0.13 1.0</ambient>
          <diffuse>0.18 0.19 0.22 1.0</diffuse>
          <specular>0.5 0.5 0.55 1.0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- 6. Turntable Inner Mounting Ring (Radial Mounting Track) -->
      <visual name='puck_turntable_inner_ring_visual'>
        <pose frame=''>-0.10 0 0.250 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.28 0.30 0.34 1.0</ambient>
          <diffuse>0.42 0.45 0.50 1.0</diffuse>
          <specular>0.7 0.75 0.8 1.0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- 7. Turntable Center Hub Accent (Brushed Aluminum Pivot with Cyan Dot) -->
      <visual name='puck_turntable_center_hub_visual'>
        <pose frame=''>-0.10 0 0.254 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.7 0.75 0.8 1.0</ambient>
          <diffuse>0.85 0.88 0.92 1.0</diffuse>
          <specular>0.95 0.95 0.95 1.0</specular>
          <emissive>0.0 0.4 0.6 1.0</emissive>
        </material>
      </visual>

      <!-- 8. Front Optical & LiDAR Sensor Recess (Recessed Sensor Pod) -->
      <visual name='puck_front_sensor_bay_visual'>
        <pose frame=''>0.215 0 0.125 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.13 0.055</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.06 1.0</ambient>
          <diffuse>0.08 0.08 0.10 1.0</diffuse>
          <specular>0.8 0.85 0.9 1.0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- 9. Front Left Optical LiDAR Lens -->
      <visual name='puck_front_lidar_lens_left'>
        <pose frame=''>0.238 0.038 0.125 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.013</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.6 0.9 1.0</ambient>
          <diffuse>0.1 0.7 1.0 1.0</diffuse>
          <emissive>0.0 0.7 1.0 1.0</emissive>
        </material>
      </visual>

      <!-- 10. Front Right Optical LiDAR Lens -->
      <visual name='puck_front_lidar_lens_right'>
        <pose frame=''>0.238 -0.038 0.125 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.013</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.6 0.9 1.0</ambient>
          <diffuse>0.1 0.7 1.0 1.0</diffuse>
          <emissive>0.0 0.7 1.0 1.0</emissive>
        </material>
      </visual>

      <!-- 11. Forward Heading Direction Notch on Top Deck -->
      <visual name='puck_heading_notch_visual'>
        <pose frame=''>0.10 0 0.252 0 0 0</pose>
        <geometry>
          <box>
            <size>0.045 0.018 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.8 1.0 1.0</ambient>
          <diffuse>0.1 0.9 1.0 1.0</diffuse>
          <emissive>0.0 0.85 1.0 1.0</emissive>
        </material>
      </visual>
      <velocity_decay/>
      <velocity_decay/>
      <velocity_decay/>
      <velocity_decay/>
    </link>
    <link name='left_wheel'>
      <pose frame=''>0 0.163 0.1 0 -0 1.5708</pose>
      <inertial>
        <pose frame=''>0 0 0 3.14159 1.57079 3.14159</pose>
        <mass>3.34</mass>
        <inertia>
          <ixx>0.00904583</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00904583</iyy>
          <iyz>0</iyz>
          <izz>0.0167</izz>
        </inertia>
      </inertial>
      <collision name='left_wheel_collision'>
        <pose frame=''>0 0 0 3.14159 1.57079 3.14159</pose>
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
            <!--
              <kp>1e+08</kp>
              <min_depth>0.005</min_depth>
              -->
              <kp>10000000.0</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='left_wheel_visual'>
        <pose frame=''>-0.071 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://TinyRobot/meshes/front_wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
    </link>
    <joint name='joint_tire_left' type='revolute'>
      <child>left_wheel</child>
      <parent>base_footprint</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <link name='right_wheel'>
      <pose frame=''>0 -0.163 0.1 0 -0 1.5708</pose>
      <inertial>
        <pose frame=''>0 0 0 3.14159 1.57079 3.14159</pose>
        <mass>3.34</mass>
        <inertia>
